# SFMP mobile environment example
# Copy to .env.local (or export these in your shell) before running Android/iOS builds.

# React Native app API base URL
API_BASE_URL=http://10.0.2.2:8085

# Google Maps keys
# Android: used by android/app/build.gradle -> resValue "google_maps_key"
MAPS_API_KEY=your_android_google_maps_key_here

# iOS: read by ios/SFMPAppBare/AppDelegate.swift and Info.plist
GOOGLE_MAPS_API_KEY=your_ios_google_maps_key_here
